# Translator runtime registration, unsupported protocols, no-op paths, and benchmarks.
exclude|internal/translator/init.go|dynamic-registry
exclude|internal/translator/*/init.go|dynamic-registry
exclude|internal/translator/*/noop_optimization_test.go|private-allocation-behavior
exclude|internal/translator/*_benchmark_test.go|performance-only
exclude|internal/translator/*_perf_test.go|performance-only
exclude|internal/translator/codex/claude/race_*_test.go|private-allocation-behavior
exclude|internal/translator/interactions/*.go|unsupported-interactions-wire
exclude|internal/translator/*/interactions/*.go|unsupported-interactions-wire
exclude|internal/translator/common/interactions_usage.go|interactions-only
exclude|internal/translator/common/antigravity_tools.go|interactions-only
exclude|internal/translator/common/antigravity_tools_test.go|interactions-only
exclude|internal/translator/common/antigravity_tools_collision_test.go|interactions-only
# ccLoad converts native Claude JSON directly, keeping one output item per block.
exclude|internal/translator/common/claude_native_response.go|ccload-native-claude-json-converter
exclude|internal/translator/common/claude_native_response_test.go|ccload-native-claude-json-converter
exclude|internal/translator/common/claude_native_sse_test.go|ccload-native-claude-json-converter
exclude|internal/translator/common/devin_tools.go|interactions-only
exclude|internal/translator/common/devin_tools_test.go|interactions-only
exclude|internal/translator/gemini/openai/responses/trailing_signature_test.go|runtime-reasoning-replay-cache-test
exclude|internal/translator/gemini/openai/responses/trailing_signature.go|runtime-reasoning-replay-cache
exclude|internal/translator/gemini/gemini/*.go|same-protocol-passthrough
exclude|internal/translator/openai/openai/chat-completions/*.go|same-protocol-passthrough
# Whole-output hashes do not define ccLoad's structured wire contracts.
exclude|internal/translator/openai/openai/responses/responses_compatibility_digest_test.go|opaque-output-digest-not-wire-contract
exclude|internal/translator/translator/*.go|sdk-dynamic-registry

# Runtime thinking application is intentionally outside the pure conversion core.
exclude|internal/thinking/apply.go|runtime-thinking-application
exclude|internal/thinking/apply_*_test.go|runtime-thinking-application
