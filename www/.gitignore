# www 目录 .gitignore
# 这些文件是从其他位置复制来的，不应提交到版本控制

# 从 web 复制的共享资源
assets/css/styles.css
assets/js/theme-init.js

# 从 web 复制的图标
favicon.svg
favicon.ico
apple-touch-icon.png
brand-mark.svg
brand-wordmark.svg

# 由 promo/ 生成的介绍视频（render.mjs + audio.sh），不入库
assets/video/*.mp4

# make www-build 的预渲染产物
dist/
