# syntax=docker/dockerfile:1
FROM debian:bookworm-slim

ARG TARGETARCH

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tzdata wget && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 1001 ccload && \
    useradd --uid 1001 --gid ccload --no-create-home --shell /usr/sbin/nologin ccload && \
    mkdir -p /app/data && \
    chown -R ccload:ccload /app

WORKDIR /app

COPY --chown=1001:1001 --chmod=0755 dist/ccload-linux-${TARGETARCH} /app/ccload
COPY --chown=1001:1001 --chmod=0755 dist/cursor-sdk-bridge-linux-${TARGETARCH} /app/cursor-sdk-bridge
COPY --chown=1001:1001 third_party/cursor-sdk-bridge/v1.0.28/LICENSE /usr/share/licenses/cursor-sdk-bridge/LICENSE

USER ccload

EXPOSE 8080

ENV PORT=8080 \
    SQLITE_PATH=/app/data/ccload.db \
    GIN_MODE=release \
    CCLOAD_CONTAINER=1

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null --tries=1 http://localhost:8080/health || exit 1

CMD ["./ccload"]
